DATA_DIR=./data
PORT=47821
ADMIN_PASSWORD=change-me-please
ADMIN_HANDLE=admin
ADMIN_NAME=Admin
# Set BIND=0.0.0.0 to publish beyond localhost (use a TLS reverse proxy)
BIND=127.0.0.1
# Set to 1 behind a reverse proxy that sets X-Forwarded-For / X-Forwarded-Proto
TRUST_PROXY=

# Backups. A backup is one .tgz with every project, page, version, comment
# thread, token and account. Download one from Settings, or set BACKUP_EVERY
# (30m, 12h, 1d) to write one on a timer into ./data/backups, keeping the
# newest BACKUP_KEEP (default 14). To move to a new machine, copy the .tgz
# into ./data/backups and point RESTORE_FROM at it; it is only used while the
# data directory is still empty, so it can stay set afterwards.
BACKUP_EVERY=
BACKUP_KEEP=
RESTORE_FROM=

# Version history. Every version is kept for HISTORY_KEEP_ALL_DAYS (default 7), then
# one per person per day until HISTORY_KEEP_DAILY_DAYS (default 90), then one per week.
HISTORY_KEEP_ALL_DAYS=
HISTORY_KEEP_DAILY_DAYS=

# Optional, no trailing slash. When set, the "url" field the API and MCP
# tools return on every page (e.g. for handing a doc's link to someone) is
# this + the page's path, so it's an absolute link instead of a path someone
# has to know to combine with a host themselves. Leave unset if Relay is
# reachable at more than one host (e.g. localhost AND Tailscale) - a path is
# correct under either; a hardcoded absolute URL would only be right for one.
PUBLIC_URL=

# Tailscale (optional): docker compose --profile tailscale up -d
# Reaches Relay at https://relay.<your-tailnet>.ts.net with no port published.
# Generate a device auth key (not an OAuth client secret / other API key) at
# https://login.tailscale.com/admin/settings/keys -- a wrong key type is
# rejected outright. Leaving this blank falls back to an interactive login
# link in `docker compose logs tailscale`, but that link expires and is
# replaced every 60-90s, so the auth key is the reliable path.
# Set TRUST_PROXY=1 above when using this, so the real client IP and HTTPS are seen.
TS_AUTHKEY=
TS_HOSTNAME=relay
